# Copy this file to .env (in hw5/) and fill in your own values.
# Placeholders only: the real .env is listed in .gitignore and is never committed.

# Required: Portkey key used for every AI call (agents route through Portkey to OpenAI)
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional (defaults shown)
PORTKEY_BASE_URL=https://api.portkey.ai/v1
OPENAI_MODEL=gpt-6-luna
